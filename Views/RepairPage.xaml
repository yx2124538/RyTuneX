<Page
    x:Class="RyTuneX.Views.RepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
        <Style x:Key="RepairRowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="30,0,0,0" />
            <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>
    <Grid x:Name="ContentArea">
        <ScrollViewer Padding="24,14,24,0">
            <StackPanel Margin="0,0,0,38" Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock x:Uid="RepairPage_RepairOptions" Text="Repair" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="1,6,0,6"/>

                <!-- ===================== System Health action card ===================== -->
                <Border CornerRadius="4" Padding="20" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="MainStatusIcon" Grid.Column="0"
                                      Glyph="&#xE90F;" FontSize="24" VerticalAlignment="Top"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="MainTitleText" x:Uid="RepairPage_SystemHealthTitle"
                                           Text="System Health" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="MainSubtitleText" x:Uid="RepairPage_SystemHealthSubtitle"
                                           Text="Check Windows for common system and storage issues."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="LastCheckedText" x:Uid="RepairPage_LastCheckedNever"
                                           Text="Last checked: Never"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ProgressGrid" ColumnSpacing="16" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="ProgressBar" Background="Transparent" Grid.Column="0" Maximum="100" Minimum="0"/>
                            <TextBlock x:Name="PercentageTextBlock" Grid.Column="1" Padding="4,0" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </Grid>
                        <TextBlock x:Name="StatusTextBlock" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>

                        <Grid>
                            <StackPanel x:Name="ActionPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="MainActionButton" x:Uid="RepairPage_CheckSystemButton"
                                        Content="Check system" Click="OnMainActionButtonClick"
                                        Style="{StaticResource AccentButtonStyle}"/>
                            </StackPanel>
                            <Button x:Uid="RepairPage_StopButton" Content="Stop" x:Name="StopButton"
                                    Click="OnStopButtonClick" Visibility="Collapsed" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===================== Results card (friendly-named rows) ===================== -->
                <Border x:Name="ResultsCard" CornerRadius="4" Padding="20,8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Visibility="Collapsed">
                    <StackPanel>

                        <Grid Padding="0,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="ImageStatusIcon" Grid.Column="0" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE9CE;"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="RepairPage_WindowsImage" Text="Windows image" Style="{StaticResource BodyTextBlockStyle}"/>
                                <TextBlock x:Uid="RepairPage_WindowsImageDescription" Text="Windows component store"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="ImageStatusText" Grid.Column="2" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <Border Style="{StaticResource RepairRowDividerStyle}"/>

                        <Grid Padding="0,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="FilesStatusIcon" Grid.Column="0" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE9CE;"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="RepairPage_SystemFiles" Text="System files" Style="{StaticResource BodyTextBlockStyle}"/>
                                <TextBlock x:Uid="RepairPage_SystemFilesDescription" Text="Protected Windows system files"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="FilesStatusText" Grid.Column="2" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <Border Style="{StaticResource RepairRowDividerStyle}"/>

                        <Grid Padding="0,12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="DriveStatusIcon" Grid.Column="0" FontSize="16" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE9CE;"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Uid="RepairPage_SystemDrive" Text="System drive" Style="{StaticResource BodyTextBlockStyle}"/>
                                <TextBlock x:Uid="RepairPage_SystemDriveDescription" Text="File system integrity"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="DriveStatusText" Grid.Column="2" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- Advanced: raw DISM/SFC/CHKDSK output, hidden by default -->
                <Expander x:Name="TechnicalDetailsExpander" x:Uid="RepairPage_TechnicalDetails"
                          Header="Technical details"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Visibility="Collapsed">
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TechnicalDetailsPanel" Spacing="4"/>
                    </ScrollViewer>
                </Expander>

                <!-- ===================== More troubleshooting ===================== -->
                <TextBlock x:Uid="RepairPage_MoreTroubleshooting" Text="More troubleshooting" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>
                <controls:SettingsCard
                    x:Uid="RepairPage_BatteryHealth">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF5FC;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <Button x:Uid="RepairPage_BatteryHealthGenerate" Click="BatteryHealthButton_Click"/>
                </controls:SettingsCard>
                <controls:SettingsCard
                    x:Uid="RepairPage_MemoryDiagnostic">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE964;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="MemStatusText" Margin="14,0" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                        <Button x:Uid="RepairPage_MemoryDiagnosticButton" x:Name="MemCheckButton" Click="MemoryHealthButton_Click"/>
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard
                    x:Uid="RepairPage_DiskOptimizations">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEB05;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <Button x:Uid="RepairPage_DiskOptimizationsButton" Click="DiskOptimizationsButton_Click"/>
                </controls:SettingsCard>
                <controls:SettingsCard
                    x:Uid="RepairPage_EventViewer"
                    Click="EventViewerSettingsCard_Click"
                    IsClickEnabled="True">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE82D;"/>
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
